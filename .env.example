# Database
POSTGRES_PASSWORD=changeme_in_production

# JWT — must be at least 32 characters, never commit the real value
JWT_SECRET=changeme_32_chars_minimum_required_here

# Minigame session signing (HMAC) — must be at least 32 characters, never commit the real value
GAME_SESSION_SECRET=changeme_32_chars_minimum_required_here

# API base URL (used by the frontend Vite proxy in dev, and by nginx in prod)
VITE_API_URL=http://localhost:8080

# Allowed CORS origin for the Go API (set to your deployed domain in production)
VITE_ORIGIN=http://localhost:9300
