{
  "name": "@district-cg/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "lint": "oxlint src/",
    "check": "tsc --noEmit && oxlint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@district-cg/shared-types": "*",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.82.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@district-cg/minigame-courier-rush": "*",
    "@district-cg/minigame-kitchen-rush": "*",
    "@district-cg/minigame-solidarity-line": "*",
    "@district-cg/minigame-tenant-match": "*",
    "@district-cg/minigame-tool-workshop": "*",
    "@district-cg/plugin-geo-weather": "*",
    "@district-cg/plugin-mesh-comms": "*",
    "@district-cg/plugin-mutual-credit": "*",
    "idb-keyval": "^6.3.0",
    "phaser": "^4.2.1",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-arm64-gnu": "1.2.8",
    "@rolldown/binding-linux-arm64-musl": "1.2.8",
    "@rolldown/binding-linux-x64-gnu": "1.2.8",
    "@rolldown/binding-linux-x64-musl": "1.2.8",
    "@tailwindcss/oxide-linux-arm64-gnu": "^4.3.3",
    "@tailwindcss/oxide-linux-arm64-musl": "^4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "^4.3.3",
    "lightningcss-linux-arm64-gnu": "^1.33.0",
    "lightningcss-linux-arm64-musl": "^1.33.0",
    "lightningcss-linux-x64-gnu": "^1.33.0",
    "lightningcss-linux-x64-musl": "^1.33.0"
