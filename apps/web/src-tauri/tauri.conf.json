{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "District: Common Ground",
  "version": "0.1.0",
  "identifier": "org.districtcommonground.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:9300",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "District: Common Ground",
        "width": 1024,
        "height": 768,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
